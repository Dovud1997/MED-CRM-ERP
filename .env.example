NODE_ENV=development
POSTGRES_DB=clinicos
POSTGRES_USER=clinicos
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://clinicos:change-me-database-password@postgres:5432/clinicos?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-at-least-32-random-bytes
JWT_REFRESH_SECRET=change-me-different-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api/v1
MINIO_ROOT_USER=clinicos
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=clinicos-private
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=change-me-local-seed-password
DEFAULT_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
COOKIE_SECURE=false
QUEUE_DISPLAY_URL=http://localhost/display
QUEUE_MEDIA_PATH=/data/queue-media
QUEUE_MEDIA_STORAGE=local
